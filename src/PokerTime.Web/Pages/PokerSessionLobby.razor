@page "/pokertime-session/{sessionId}/lobby"
@layout PokerSessionLayout
@inherits PokerSessionLobbyBase

@if (SessionStatus == null)
{
    if (HasLoaded)
    {
        <ErrorMessage Text="This poker session cannot be found!"/>
    }
    else
    {
        <p>Hold on... crunching the data</p>
    }

    return;
}

<CascadingValue Value=@SessionIdObject IsFixed="true">
    <CascadingValue Value=@CurrentParticipant IsFixed="true">
        <CascadingValue Value=@SessionStatus>
            <div class="row" data-test-element-id="main-board">
                <div class="col">
                    <SessionBoard/>
                </div>

                <div class="col-4">
                    <div class="row">
                        <div class="col">
                            <SessionStatusPanel/>
                        </div>
                    </div>
                    <div class="row pt-3">
                        <div class="col-12">
                            <SessionOnlineList SessionId="@SessionId" CurrentParticipant="@CurrentParticipant"/>
                        </div>
                    </div>
                </div>
            </div>
        </CascadingValue>
    </CascadingValue>
</CascadingValue>