{
  "Server": {
    "BaseUrl": "https://emscrumtools.azurewebsites.net/pokertime"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "File": {
      "Path": null,
      "Append": "True",
      "FileSizeLimitBytes": 1048576,
      "MaxRollingFiles": 24
    }
  },
  "AllowedHosts": "*",
  "Security": {
    "LobbyCreationPassphrase": null,
    "EnableProxyMode": false
  },
  "Database": {
    "DatabaseProvider": "Sqlite",
    "ConnectionString": "Data Source=poker-time.db;",
    "Server": "",
    "Database": "poker-time",
    "IntegratedSecurity": true,
    "UserId": null,
    "Password": null,
    "ConnectionTimeout": null,
    "Encrypt": null
  },
  "Mail": {
    "Host": "localhost",
    "EnableSSL": false,
    "Port": 25,
    "UserName": "",
    "Password": "",
    "FromAddress": "app@example.com",
    "FromDisplayName": "PokerTime [DEV]",
    "TestMailTarget": "void@example.com"
  },
  "SassCompiler": {
    "SourceFolder": "wwwroot/scss",
    "TargetFolder": "wwwroot/css",
    "Arguments": "--style=expanded"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/.log",
          "rollingInterval": "Day",
          "flushToDiskInterval": 30,
          "shared": true
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ]
  }
}
