<div class="reveal @CssClass @(Inline ? "reveal--inline" : string.Empty)">
    <div class="reveal__contents">@ChildContent</div>
</div>

@code {


    [Parameter]
    public RenderFragment ChildContent { get; set; }

    [Parameter]
    public string CssClass { get; set; }

    [Parameter]
    public bool Inline { get; set; }
}