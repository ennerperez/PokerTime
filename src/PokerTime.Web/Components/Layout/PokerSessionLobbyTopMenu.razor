@using PokerTime.Domain.Entities

<aside class="menu">
    <TopMenu BrandIsClickable="false">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item">
                <NavLink class="nav-link" href="#" Match="NavLinkMatch.All">
                    @_layoutInfo.Title
                </NavLink>
            </li>
        </ul>
        <div class="poker-progress-container">
            <ul class="navbar-nav poker-progress @(CurrentStage == SessionStage.NotStarted ? "poker-progress--inactive" : string.Empty)">
                <PokerSessionProgressItem
                    CurrentStage="@CurrentStage"
                    ApplicableTo="@SessionStage.Discussion"
                    Text="Discuss"/>
                <PokerSessionProgressItem
                    CurrentStage="@CurrentStage"
                    ApplicableTo="@SessionStage.Estimation"
                    Text="Estimation"/>
                <PokerSessionProgressItem
                    CurrentStage="@CurrentStage"
                    ApplicableTo="@SessionStage.EstimationDiscussion"
                    Text="Consolidate"/>
                <PokerSessionProgressItem
                    CurrentStage="@CurrentStage"
                    ApplicableTo="@SessionStage.Finished"
                    Text="Finished"/>
            </ul>
        </div>
    </TopMenu>
</aside>

@code
{

    private PokerSessionLayoutInfo _layoutInfo = new PokerSessionLayoutInfo("Loading...");

    private SessionStage CurrentStage => _layoutInfo.Stage ?? SessionStage.NotStarted;

    public void Update(in PokerSessionLayoutInfo layoutInfo)
    {
        _layoutInfo = layoutInfo;

        StateHasChanged();
    }
}