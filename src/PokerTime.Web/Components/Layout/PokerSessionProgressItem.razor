@using PokerTime.Domain.Entities

<li class="nav-item poker-progress__item @CssClass">
    <span class="nav-link">@Text</span>
</li>

@code {

    [Parameter]
    public SessionStage CurrentStage { get; set; }

    [Parameter]
    public SessionStage ApplicableTo { get; set; }

    [Parameter]
    public string Text { get; set; }

    private bool IsPrevious => ApplicableTo < CurrentStage;
    private bool IsCurrent => CurrentStage == ApplicableTo;

    private string CssClass
    {
        get
        {
            if (IsCurrent)
            {
                return "poker-progress__item--is-current active";
            }

            if (IsPrevious)
            {
                return "poker-progress__item--is-previous";
            }

            return "poker-progress__item--future";
        }
    }

}