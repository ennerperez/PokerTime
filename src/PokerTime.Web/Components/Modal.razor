<div id="@Id" class="modal @(this.IsShown ? "active" : String.Empty)"  tabindex="-1" role="dialog">
    <div class="modal-dialog" data-test-element-id="@Id">
        <div class="modal-content">
            @ChildContent
        </div>
    </div>
</div>

@code {


    [Parameter] public RenderFragment ChildContent { get; set; }

    [Parameter] public bool IsShown { get; set; }
    [Parameter] public string Id { get; set; }
}